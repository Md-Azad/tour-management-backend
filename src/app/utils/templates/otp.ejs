<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title><%= subject %></title>
  </head>
  <body
    style="
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
      padding: 20px;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="
        max-width: 600px;
        margin: auto;
        background-color: #ffffff;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      "
    >
      <tr>
        <td>
          <p style="font-size: 16px; color: #333">
            Hi <strong><%= name %></strong>,
          </p>
          <p style="font-size: 16px; color: #333">
            You're receiving this email to verify your identity. Please use the
            OTP code below:
          </p>

          <p
            style="
              font-size: 36px;
              font-weight: bold;
              color: #222;
              letter-spacing: 6px;
              text-align: center;
              margin: 30px 0;
            "
          >
            <%= otp %>
          </p>

          <p style="font-size: 14px; color: #777; text-align: center">
            ⚠️ This OTP will expire in 2 minutes.
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
